rules_version = '2';

// Regras de segurança do Firestore. Rodam no servidor do Google: são elas que
// protegem as tarefas, já que a configuração do Firebase é pública no app.
// Para aplicar: Firebase console > Firestore Database > Regras > colar > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada pessoa só lê e escreve as próprias tarefas.
    match /usuarios/{uid}/tarefas/{tarefaId} {
      allow read, delete: if eDono(uid);
      allow create, update: if eDono(uid) && tarefaValida(request.resource.data);
    }

    function eDono(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Mesmo formato aceito pela importação (dados.js), mais o criadoEm interno.
    function tarefaValida(t) {
      return t.keys().hasOnly(['aba', 'grupo', 'titulo', 'desc', 'tag', 'tagTexto', 'status', 'ordem', 'criadoEm'])
        && t.aba in ['projetos', 'pessoal']
        && t.grupo is string && t.grupo.size() > 0 && t.grupo.size() <= 200
        && t.titulo is string && t.titulo.size() > 0 && t.titulo.size() <= 500
        && t.desc is string && t.desc.size() <= 5000
        && t.tag in ['next', 'wait', 'decide', 'someday']
        && t.tagTexto is string && t.tagTexto.size() <= 100
        && t.status in ['aberto', 'feito', 'encerrado']
        && t.ordem is number
        && t.criadoEm is number;
    }
  }
}
